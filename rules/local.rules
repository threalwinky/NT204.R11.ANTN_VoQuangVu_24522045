# Sample Snort rules for BT3
# Rules use the supported Snort subset.

alert tcp any any -> any 80 (msg:"HTTP GET observed"; sid:1000001; rev:1; content:"GET "; nocase; classtype:web-application-attack; priority:2;)

alert tcp any any -> any 80 (msg:"HTTP admin path observed"; sid:1000002; rev:1; content:"/admin"; nocase; classtype:web-application-attack; priority:2;)

alert tcp any any -> any 80 (msg:"HTTP POST observed"; sid:1000003; rev:1; content:"POST "; nocase;)

alert udp any any -> any 53 (msg:"DNS example query observed"; sid:1000004; rev:1; content:"example"; nocase;)

alert tcp any any -> any 443 (msg:"HTTPS SYN observed"; sid:1000005; rev:1; flags:S; dsize:0;)
